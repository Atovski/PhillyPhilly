# UKNode (cPanel / LiteSpeed). Copied to the site root by the build.

Options -Indexes
RewriteEngine On

# Sync state written by the GitHub deploy action; not for the public.
<Files ".ftp-deploy-sync-state.json">
  Require all denied
</Files>

# HTTPS + www -> apex. /.well-known stays reachable so AutoSSL can validate.
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://phillyphilly.co.uk%{REQUEST_URI} [L,R=301]

# Old single-page URLs -> new structure. Keeps any existing links, QR codes and
# Instagram bio links working, and passes ranking signals to the new pages.
# THE_REQUEST stops the DirectoryIndex lookup for / from matching index.html.
RewriteCond %{THE_REQUEST} \s/index\.html[\s?]
RewriteRule ^index\.html$ / [L,R=301]
RewriteRule ^gallery\.html$ /gallery/ [L,R=301]
RewriteRule ^calendar\.html$ /find-us/ [L,R=301]
RewriteRule ^admin\.html$ /admin/ [L,R=301]

# Convenience shortcuts (worth putting on flyers and business cards)
RewriteRule ^(quote|book)/?$ /contact/ [L,R=301]
RewriteRule ^wedding/?$ /weddings/ [L,R=301]
RewriteRule ^allergens/?$ /menu/#allergens [L,R=301,NE]
RewriteRule ^(party|private-events)/?$ /private-parties/ [L,R=301]
RewriteRule ^christmas/?$ /christmas-party-catering/ [L,R=301]
RewriteRule ^prices/?$ /food-truck-hire-cost/ [L,R=301]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # Image file names change when the image changes, so they can be cached hard.
  # style.css and main.js keep the same name, so they get a shorter lifetime.
  <FilesMatch "\.(webp|jpe?g|png|svg|gif|ico|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  <FilesMatch "\.json$">
    Header set Cache-Control "public, max-age=300"
  </FilesMatch>
</IfModule>
